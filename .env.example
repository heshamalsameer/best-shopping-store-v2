# PostgreSQL connection (Neon, Supabase, Vercel Postgres, local…)
DATABASE_URL="postgresql://user:password@localhost:5432/shop"
# Any long random string
JWT_SECRET="change-me"

# Cloudinary (admin image upload) – use an *unsigned* upload preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-unsigned-preset"

# Stream Chat (support chat) – https://getstream.io/dashboard → your app → API keys
STREAM_API_KEY="your-stream-key"
STREAM_API_SECRET="your-stream-secret"

# Optional — the site URL used for API calls from server components
# NEXT_PUBLIC_DOMAIN="http://localhost:3000"
